{
  "name": "monitor-produtividade",
  "version": "1.0.0",
  "description": "Monitor de produtividade com system tray - coleta atividade e envia quando necessário",
  "main": "src/main.js",
  "bin": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "start:service": "set MONITOR_HEADLESS=1&& node src/main.js --service",
    "dev": "node --watch src/main.js",
    "build": "node scripts/build.js",
    "build:pkg": "pkg . --targets node18-win-x64 --output dist/monitor-produtividade.exe --compress GZip",
    "build:debug": "pkg . --targets node18-win-x64 --output dist/monitor-produtividade.exe --debug",
    "service:install": "node scripts/install-service.js",
    "service:uninstall": "node scripts/uninstall-service.js",
    "postinstall": "node -e \"console.log('OK. Desktop: npm start | Servico: npm run service:install (Admin)')\""
  },
  "keywords": [
    "tray",
    "monitor",
    "produtividade",
    "windows",
    "system-tray",
    "service"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "node-windows": "^1.0.0-beta.8",
    "systray2": "^2.1.4",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": [
      "src/**/*.js"
    ],
    "assets": [
      "assets/**/*",
      "config/**/*",
      "node_modules/systray2/traybin/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist",
    "compress": "GZip"
  }
}